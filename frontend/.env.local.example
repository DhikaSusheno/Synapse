# Synapse Frontend Environment Configuration
# Copy this file to .env.local and adjust values as needed
#
# BUG-11: backend mewajibkan token API di setiap route. Token TIDAK boleh
# masuk bundle browser, jadi ia hanya dibaca di server (tanpa NEXT_PUBLIC_)
# dan disuntikkan oleh route handler app/backend/[...path]/route.ts.

# Backend API URL untuk browser.
# WAJIB path relatif (/backend) supaya request lewat route handler proxy yang
# bisa menyuntikkan token. Jangan diisi http://localhost:8000 - browser
# tidak bisa mengirim header token, dan akan mendapat 401.
NEXT_PUBLIC_BACKEND_URL=/backend

# Token API. Harus PERSIS sama dengan SYNAPSE_API_TOKEN milik backend,
# kalau tidak semua request akan 401 (proxy membalas 502 dengan petunjuk).
# Buat token acak, misalnya: python -c "import secrets;print(secrets.token_urlsafe(32))"
SYNAPSE_API_TOKEN=

# Backend API URL untuk panggilan server-side (route handler proxy).
BACKEND_URL=http://localhost:8000

# #63: proxy /backend/[...path] menyuntikkan SYNAPSE_API_TOKEN ke semua
# pemanggil, jadi siapa pun yang bisa menjangkau port Next.js bisa memakai
# API terproteksi. Dua lapis mitigasi yang sudah aktif:
#   1. request browser dengan Sec-Fetch-Site: cross-site otomatis ditolak 403
#   2. Authorization milik klien tidak diteruskan ke backend
#
# Kalau Next.js di-bind ke interface publik (bukan localhost), isi daftar
# origin yang SAH untuk memanggil proxy, dipisah koma. Kosongkan kalau
# Next.js hanya listens di localhost - itu kondisi paling aman.
#
# Catatan: daftar origin tidak mengubah sifat dasarnya. Klien non-browser
# (curl, skrip jaringan) tetap bisa memakai proxy selama bisa menjangkau
# port tersebut; mitigasi sebenarnya untuk itu adalah tidak mengekspos port
# ke jaringan.
# SYNAPSE_PROXY_ALLOWED_ORIGINS=http://localhost:3000

# Enable live SSE connection to backend (set to true to use real backend)
# If false, the app runs in MOCK mode with simulated data
# Catatan: EventSource tidak bisa mengirim header kustom, jadi SSE juga harus
# lewat /backend - jangan arahkan ke http://localhost:8000 langsung.
NEXT_PUBLIC_USE_LIVE_SSE=true
