# Synapse Frontend Environment Configuration
# Copy this file to .env.local and adjust values as needed

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Enable live SSE connection to backend (set to true to use real backend)
# If false, the app runs in MOCK mode with simulated data
NEXT_PUBLIC_USE_LIVE_SSE=true

# Internal backend URL (for server-side calls)
BACKEND_URL=http://localhost:8000