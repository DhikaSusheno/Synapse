# Synapse Frontend — Environment Variables
# Salin file ini ke .env.local sebelum menjalankan development server
#
# cp .env.local.example .env.local

# URL backend FastAPI (default: localhost:8000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Set ke "true" untuk aktifkan live SSE + real API dari backend.
# Set ke "false" (atau hapus) untuk mode mock dengan simulasi animasi.
# NEXT_PUBLIC_USE_LIVE_SSE=false
NEXT_PUBLIC_USE_LIVE_SSE=false

# (Server-side only, untuk proxy route /api/graph)
# Biasanya sama dengan NEXT_PUBLIC_BACKEND_URL tapi tanpa NEXT_PUBLIC_ prefix
BACKEND_URL=http://localhost:8000
