{
  "name": "synapse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"lib/*.test.ts\""
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-force-graph-2d": "^1.25.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "comments": {
    "overrides": "Dipakai karena rantai transitive (postcss ikut terpasang next, glob ikut @next/eslint-plugin-next) menahan versi rentan. Kunci override sengaja berbentuk RANGE, bukan nama paket polos: glob@7.2.3 juga ada di tree dan tidak boleh dipaksa naik ke 10.x karena itu major."
  },
  "overrides": {
    "postcss": "$postcss",
    "glob@>=10.2.0 <10.5.0": "^10.5.0",
    "minimatch@>=9.0.0 <9.0.7": "^9.0.7"
  }
}
