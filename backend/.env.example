# =============================================================================
# Synapse Backend — Environment Variables
# =============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env
#
# JANGAN commit file `.env` yang berisi token/rahasia ke Git.
# =============================================================================

# ---------------------------------------------------------------------------
# SYNAPSE_API_TOKEN  (WAJIB untuk production)
# ---------------------------------------------------------------------------
# Token autentikasi untuk mengakses seluruh endpoint non-publik.
# Jika tidak disetel, backend akan OTOMATIS generate token acak saat startup
# dan mencetak token tersebut ke log (hanya untuk development).
#
# Gunakan perintah berikut untuk generate token kuat:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Contoh:
#   SYNAPSE_API_TOKEN=my-super-secret-token-here
SYNAPSE_API_TOKEN=

# ---------------------------------------------------------------------------
# SYNAPSE_ALLOWED_ORIGINS  (Issue #72 — CORS dynamic port)
# ---------------------------------------------------------------------------
# Daftar origin (comma-separated) yang diizinkan oleh CORS middleware.
# Default: http://localhost:3000, http://127.0.0.1:3000,
#          http://localhost:3001, http://127.0.0.1:3001
#
# Jika frontend berjalan di port lain (misalnya 3002), tambahkan di sini.
# Wildcard (*) TIDAK diizinkan — akan diabaikan dan fallback ke default.
#
# Contoh:
#   SYNAPSE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:5173
SYNAPSE_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# FERNET_KEY  (opsional — enkripsi token storage)
# ---------------------------------------------------------------------------
# Kunci 32-byte (base64-encoded, 44 karakter) untuk mengenkripsi token
# yang disimpan di database. Jika tidak disetel, backend generate kunci
# acak setiap startup (token terenkripsi sebelumnya tidak bisa didekripsi).
#
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---------------------------------------------------------------------------
# SYNAPSE_PUBLIC_PATHS  (opsional — path publik tambahan)
# ---------------------------------------------------------------------------
# Path tambahan yang bisa diakses tanpa token, comma-separated.
# Default publik: /health, /docs, /redoc, /openapi.json, /docs/oauth2-redirect
#
# Contoh:
#   SYNAPSE_PUBLIC_PATHS=/custom-health,/status
SYNAPSE_PUBLIC_PATHS=
